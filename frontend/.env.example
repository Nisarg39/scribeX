# ==============================================================================
# ScribeX Frontend Environment Variables Template
# Expo automatically loads variables prefixed with EXPO_PUBLIC_ into the client bundle.
# ==============================================================================

# Backend REST API Base URL
# Local Dev:  http://localhost:8000 (Web / iOS Simulator) or http://10.0.2.2:8000 (Android)
# Production: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# Real-Time WebSocket Doorbell URL
# Optional: If omitted, derived automatically from EXPO_PUBLIC_API_URL
# Local Dev:  ws://localhost:8000/ws/sync
# Production: wss://api.yourdomain.com/ws/sync
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws/sync

# Note: User authentication & tenant identification are handled dynamically
# by the app's central auth state management (JWT/session), not hardcoded in .env.
