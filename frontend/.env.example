# ==============================================================================
# ScribeX Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `frontend/.env` (or `frontend/.env.local`).
# 2. Replace the placeholder values with your actual project credentials.
# 3. Never commit `.env` or `.env.local` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD (Managed Multi-Tenant Option A - Required for Cloud Sync & Auth)
# ------------------------------------------------------------------------------
# Find these in your Supabase Dashboard: Project Settings -> API
# Note: Variables exposed to Expo/React Native client bundle must start with EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH AUTHENTICATION (Google OAuth Only Sign-In)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Authentication -> Providers -> Google:
# 1. Enable Google provider.
# 2. Add your Google Client ID and Google Client Secret (from Google Cloud Console).
# 3. Add `https://<your-project-ref>.supabase.co/auth/v1/callback` to Google Cloud
#    Console "Authorized redirect URIs".
# 
# (Optional) Native client IDs if using native Google Sign-In SDK:
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. SCRIBEX BACKEND / AI GATEWAY (Phase 3 Serverless Micro-Routes)
# ------------------------------------------------------------------------------
# Single backend AI gateway endpoint (Next.js server or Supabase Edge Functions)
# EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. NOTE ON MODEL API KEYS (BYOK - Bring Your Own Key)
# ------------------------------------------------------------------------------
# User AI API keys (Google Gemini, Anthropic Claude, OpenAI) are NOT stored in .env!
# Users input their keys directly in the ScribeX Settings UI.
# They are stored in on-device SecureStore (iOS/Android) or encrypted Web storage,
# and passed via ephemeral encrypted headers for zero server token markup.
