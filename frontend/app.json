{
  "expo": {
    "name": "ScribeX",
    "slug": "scribex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "scribex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101115"
    },
    "android": {
      "package": "com.nashtech.scribex",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101115"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VIDEO",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "*/*" },
            { "mimeType": "text/*" },
            { "mimeType": "image/*" },
            { "mimeType": "video/*" },
            { "mimeType": "audio/*" },
            { "mimeType": "application/pdf" },
            { "mimeType": "application/zip" },
            { "mimeType": "application/octet-stream" },
            { "mimeType": "application/x-zip-compressed" }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "*/*" },
            { "mimeType": "image/*" },
            { "mimeType": "video/*" },
            { "mimeType": "audio/*" }
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.nashtech.scribex",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ScribeX uses your camera to scan documents, notes, and receipts.",
        "NSMicrophoneUsageDescription": "ScribeX uses your microphone to record voice notes and audio memos.",
        "NSFaceIDUsageDescription": "ScribeX uses Face ID to securely unlock your private notes, folders, and workspace.",
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Text Document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.text",
              "public.plain-text",
              "public.utf8-plain-text"
            ]
          },
          {
            "CFBundleTypeName": "ZIP Archive",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.pkware.zip-archive",
              "public.zip-archive"
            ]
          },
          {
            "CFBundleTypeName": "Image",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.image",
              "public.jpeg",
              "public.png"
            ]
          },
          {
            "CFBundleTypeName": "Video",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.movie",
              "public.mpeg-4",
              "public.audiovisual-content"
            ]
          },
          {
            "CFBundleTypeName": "Audio",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.audio",
              "public.mp3",
              "org.xiph.opus"
            ]
          },
          {
            "CFBundleTypeName": "PDF Document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "All Files",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.data",
              "public.content",
              "public.item"
            ]
          }
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      "expo-audio",
      "./plugins/withScribeXShare"
    ]
  }
}
