{
  "project": "scribeX",
  "scope": "workspace-only",
  "stack": {
    "framework": "Expo SDK 57 + React Native 0.86 + Expo Router",
    "styling": "NativeWind v4 (Tailwind CSS) + inline React Native style objects for flex safety",
    "storage": "Local-first SQLite (expo-sqlite on iOS/Android, sql.js WASM + IndexedDB on Web)"
  },
  "paths": {
    "screens": {
      "rootLayout": "frontend/app/_layout.tsx",
      "entry": "frontend/app/index.tsx",
      "onboarding": "frontend/app/onboarding.tsx",
      "signin": "frontend/app/signin.tsx",
      "home": "frontend/app/home.tsx",
      "noteEditor": "frontend/app/note/[id].tsx"
    },
    "views": {
      "notesList": "frontend/src/components/NotesView.tsx",
      "notesBatchBar": "frontend/src/components/notes/NotesBatchActionBar.tsx",
      "notesSearchBar": "frontend/src/components/notes/NotesSearchBar.tsx",
      "notesFilterTrack": "frontend/src/components/notes/NotesFilterTrack.tsx",
      "folderContextBanners": "frontend/src/components/notes/FolderContextBanners.tsx",
      "createFolderModal": "frontend/src/components/notes/CreateFolderModal.tsx",
      "noteCard": "frontend/src/components/notes/NoteCard.tsx",
      "tasksList": "frontend/src/components/TasksView.tsx",
      "reminderPicker": "frontend/src/components/common/ReminderPickerModal.tsx",
      "reminderDateTimeUtils": "frontend/src/components/common/reminder/reminderDateTimeUtils.ts",
      "calendarMonthGrid": "frontend/src/components/common/reminder/CalendarMonthGrid.tsx",
      "recurrenceSection": "frontend/src/components/common/reminder/RecurrenceSection.tsx",
      "bottomDock": "frontend/src/components/BottomDock.tsx"
    },
    "editorCore": {
      "blockEditor": "frontend/src/components/editor/BlockEditor.tsx",
      "blockRenderer": "frontend/src/components/editor/BlockRenderer.tsx",
      "universalWrapper": "frontend/src/components/editor/UniversalBlockWrapper.tsx",
      "header": "frontend/src/components/editor/components/EditorHeader.tsx",
      "commandBar": "frontend/src/components/editor/components/EditorCommandBar.tsx",
      "insertPalette": "frontend/src/components/editor/components/InsertPaletteModal.tsx",
      "slashPalette": "frontend/src/components/editor/components/SlashCommandPalette.tsx",
      "templatePicker": "frontend/src/components/editor/components/TemplatePicker.tsx",
      "backlinksStrip": "frontend/src/components/editor/components/BacklinksStrip.tsx",
      "blocksDir": "frontend/src/components/editor/blocks/",
      "hooksDir": "frontend/src/components/editor/hooks/",
      "editorBlockFactories": "frontend/src/components/editor/hooks/editorBlockFactories.ts",
      "editorBlockMutations": "frontend/src/components/editor/hooks/useEditorBlockMutations.ts"
    },
    "stateAndData": {
      "notesStore": "frontend/src/state/useNotesStore.tsx",
      "seedData": "frontend/src/state/seedData.ts",
      "folderStoreActions": "frontend/src/state/slices/useFolderStoreActions.ts",
      "reminderStoreActions": "frontend/src/state/slices/useReminderStoreActions.ts",
      "workspaceBackupActions": "frontend/src/state/slices/useWorkspaceBackupActions.ts",
      "astSerializer": "frontend/src/core/astSerializer.ts",
      "astHelpers": "frontend/src/core/ast/astHelpers.ts",
      "parseMarkdown": "frontend/src/core/ast/parseMarkdown.ts",
      "serializeBlocks": "frontend/src/core/ast/serializeBlocks.ts",
      "searchIndexer": "frontend/src/core/searchIndexer.ts",
      "noteQueryEngine": "frontend/src/core/noteQueryEngine.ts",
      "actionHistory": "frontend/src/core/actionTracker/ActionHistoryManager.ts",
      "noteTemplates": "frontend/src/core/templates/noteTemplates.ts",
      "notesRepo": "frontend/src/db/notesRepo.ts",
      "tasksRepo": "frontend/src/db/tasksRepo.ts",
      "remindersRepo": "frontend/src/db/remindersRepo.ts",
      "searchHistoryRepo": "frontend/src/db/searchHistoryRepo.ts",
      "types": "frontend/src/types/note.ts",
      "reminderTypes": "frontend/src/types/reminder.ts",
      "notificationService": "frontend/src/services/notifications/NotificationService.ts",
      "theme": "frontend/src/theme/index.ts"
    },
    "inboundShare": {
      "shareTypes": "frontend/src/core/share/types.ts",
      "whatsappParser": "frontend/src/core/share/whatsappChatParser.ts",
      "synthesizer": "frontend/src/core/share/shareBlockSynthesizer.ts",
      "shareBarrel": "frontend/src/core/share/index.ts",
      "nativeShareBridge": "frontend/src/services/share/NativeShareBridge.ts",
      "shareIngestService": "frontend/src/services/share/ShareIngestService.ts",
      "shareDestinationModal": "frontend/src/components/share/ShareDestinationModal.tsx",
      "iosSharePlugin": "frontend/plugins/withScribeXShare.js",
      "iosNativeShareDir": "frontend/ios-native-share/",
      "androidShareModule": "frontend/android/app/src/main/java/com/nashtech/scribex/share/ShareIntentModule.kt",
      "androidSharePackage": "frontend/android/app/src/main/java/com/nashtech/scribex/share/ShareIntentPackage.kt"
    },
    "security": {
      "biometrics": "frontend/src/core/security/biometrics.ts",
      "securityContext": "frontend/src/context/SecurityContext.tsx",
      "pinPasswordSettings": "frontend/app/settings/pin-password.tsx",
      "appLockOverlay": "frontend/src/components/security/AppLockScreenOverlay.tsx",
      "pinPasswordPromptModal": "frontend/src/components/security/PinPasswordPromptModal.tsx"
    },
    "docsAndReports": {
      "implementationPlan": "implementation_plan.md",
      "index": "docs/README.md",
      "masterTracker": "docs/Master_Tasks_Tracker.md",
      "masterFrontendSpec": "docs/Unified_Frontend_Master_Specification.md",
      "masterBackendAndAiSpec": "docs/Unified_Backend_and_AI_Master_Specification.md",
      "designSystem": "docs/ScribeX-Pastel-Tile-UI-Design-System.md",
      "productRequirements": "docs/Product_Requirements.md",
      "uiUxAuditReport": "docs/UI_UX_Cross_Platform_Inconsistencies_Report.md",
      "futureIdeas": "docs/future_ideas.md"
    }
  },
  "validationCommands": {
    "typecheck": "cd frontend && npx tsc --noEmit",
    "remindersAudit": "node scripts/test_headless_reminders_and_notifications.mjs",
    "uiUxAudit": "node scripts/test_cross_platform_ui_ux.mjs",
    "blocksAndAstAudit": "npm --prefix frontend run audit:all",
    "interactionsAndUndoAudit": "npm --prefix frontend run test:interactions",
    "maestroFlowsValidate": "npm --prefix frontend run test:e2e:validate",
    "sharePipelineTest": "cd frontend && npx tsx ../scripts/test_inbound_share_pipeline.mjs",
    "allSuites": "npm --prefix frontend run test:all"
  }
}

