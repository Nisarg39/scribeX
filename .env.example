# ScribeX Backend Environment Configuration & Secrets Template
# Copy this file to .env or .env.local (strictly git-ignored) to store backend secrets.
#
# NOTE: User AI keys (Gemini, Anthropic Claude, OpenAI) are NOT stored here.
# Per ScribeX Client-Direct BYOK architecture, AI keys are entered directly by the user 
# inside the ScribeX App Settings UI and stored securely in on-device local storage.

# ==============================================================================
# Meta WhatsApp Cloud API (Phase 2 Outbound Reminders & Webhook Relay)
# ==============================================================================
WHATSAPP_CLOUD_API_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_DEFAULT_RECIPIENT_PHONE=your_personal_phone_with_country_code # e.g. +1234567890

# ==============================================================================
# Cloud Sync & Database (Phase 2 Supabase Backend)
# ==============================================================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
